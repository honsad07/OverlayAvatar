<Window x:Class="InterakcniOverlayAvatar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterakcniOverlayAvatar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="True"
        >

    <Canvas>
        <StackPanel x:Name="PohybliveOkno" Canvas.Left="100" Canvas.Top="100" Width="200" >
            <Border Width="200" Height="200" ClipToBounds="True">
                <Image x:Name="AvatarImage"
                   Stretch="UniformToFill"
                   Source="/avatars/1_up.png" />
            </Border>

            <Border Background="White" Padding="10" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ActivityText" Text="0" Foreground="Black" FontSize="20" VerticalAlignment="Center" FontWeight="Bold" />

                    <Button Grid.Column="1" Content="☰" FontSize="18" Width="30" Height="30" Click="MenuButton_Click" Cursor="Hand" Background="White" BorderBrush="Black" BorderThickness="1" />
                </Grid>
            </Border>
        </StackPanel>
    </Canvas>
</Window>